# Variables usadas durante el build del frontend Docker.
# NEXT_PUBLIC_API_URL debe ser accesible desde el navegador del host.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-key>
NEXT_PUBLIC_API_URL=https://happy-paws-api.vercel.app
# Orígenes autorizados por la API, separados por comas.
CORS_ORIGINS=https://happy-paws-ten.vercel.app