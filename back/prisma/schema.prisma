generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  VET
  RECEPTIONIST
  OWNER
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum VaccinationStatus {
  ADMINISTERED
  PENDING
  OVERDUE
}

model User {
  id           BigInt   @id @default(autoincrement())
  email        String   @unique
  fullName     String   @map("full_name")
  passwordHash String   @map("password_hash")
  role         UserRole
  createdAt    DateTime @default(now()) @map("created_at")
  appointments Appointment[] @relation("VetAppointments")
  owner        Owner?
  @@map("users")
}

model Owner {
  id        BigInt   @id @default(autoincrement())
  fullName  String   @map("full_name")
  phone     String
  email     String?  @unique
  address   String?
  userId    BigInt?  @unique @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User?    @relation(fields: [userId], references: [id])
  pets      Pet[]
  @@map("owners")
}

model Pet {
  id          BigInt   @id @default(autoincrement())
  ownerId     BigInt   @map("owner_id")
  petTag      String   @unique @map("pet_tag")
  name        String
  species     String
  breed       String?
  birthDate   DateTime? @map("birth_date")
  weight      Decimal? @db.Decimal(5, 2)
  createdAt   DateTime @default(now()) @map("created_at")
  owner       Owner @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  vaccinations Vaccination[]
  @@index([name])
  @@map("pets")
}

model Appointment {
  id          BigInt @id @default(autoincrement())
  petId       BigInt @map("pet_id")
  vetId       BigInt @map("vet_id")
  scheduledAt DateTime @map("scheduled_at")
  reason      String
  notes       String?
  status      AppointmentStatus @default(SCHEDULED)
  pet         Pet @relation(fields: [petId], references: [id], onDelete: Cascade)
  vet         User @relation("VetAppointments", fields: [vetId], references: [id])
  services    AppointmentService[]
  vaccinations Vaccination[]
  @@index([scheduledAt])
  @@map("appointments")
}

model Service {
  id          BigInt @id @default(autoincrement())
  name        String
  description String?
  priceCents  Int @map("price_cents")
  appointments AppointmentService[]
  @@map("services")
}

model AppointmentService {
  appointmentId BigInt @map("appointment_id")
  serviceId     BigInt @map("service_id")
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id])
  @@id([appointmentId, serviceId])
  @@map("appointment_services")
}

model Vaccination {
  id            BigInt @id @default(autoincrement())
  petId         BigInt @map("pet_id")
  appointmentId BigInt? @map("appointment_id")
  vaccineName   String @map("vaccine_name")
  administeredAt DateTime @map("administered_at")
  nextDueDate   DateTime @map("next_due_date")
  status        VaccinationStatus
  pet           Pet @relation(fields: [petId], references: [id], onDelete: Cascade)
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  @@index([nextDueDate])
  @@map("vaccinations")
}

model AuditLog {
  id        BigInt @id @default(autoincrement())
  userId    BigInt?
  action    String
  entity    String
  entityId  BigInt?
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")
  @@index([createdAt])
  @@map("audit_logs")
}
